---
import ProjectDetails from '@components/pages/ProjectDetails.astro';
import { getProjects } from '@api/projects';
import { getCompanyById } from '@api/companies';

export function getStaticPaths() {
  const projects = getProjects('es');
  return projects.map((project) => {
    const company = getCompanyById(project.companySlug, 'es');

    if (!company) {
      throw new Error(
        `Company with slug "${project.companySlug}" not found for project "${project.slug}"`,
      );
    }

    return {
      params: { slug: project.slug },
      props: {
        project: project,
        company: company,
        achievements: project.achievements,
        technologies: project.technologies,
        headerImage: project.headerImage,
        views: project.views,
      },
    };
  });
}

const props = Astro.props;
---

<ProjectDetails {...props} />
