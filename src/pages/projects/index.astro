---
import { ProjectsFilter } from '@components/ProjectsFilter';
import { ProjectsDisplay } from '@components/ProjectsDisplay';
import { ProjectsViewToggle } from '@components/ProjectsViewToggle';
import { getProjects } from '@api/projects';
import Layout from '@layouts/Layout.astro';

const projects = getProjects();
---

<Layout title="Rafael Romero - All Projects">
  <div class="max-w-[1440px] mx-auto w-full flex flex-col items-center pb-20 px-6 md:px-[72px]">
    <!-- Hero Banner -->
    <section class="max-w-[1240px] w-full pt-4">
      <div
        class="flex p-6 md:p-8 items-center gap-6 rounded-[24px] border border-white/5"
        style={{
          background:
            'radial-gradient(120% 100% at 80% 0%, rgba(255, 41, 117, 0.15) 0%, rgba(1, 8, 57, 0.35) 45%, #1A1A1A 80%), linear-gradient(109.02deg, rgba(1, 8, 57, 0.6) 0%, rgba(26,26,26,0.5) 60%)',
        }}
      >
        <div class="flex flex-col gap-4">
          <h1 class="text-[32px] md:text-[40px] leading-[1.1] font-bold text-foreground">
            All Projects
          </h1>
          <p
            class="text-[16px] leading-[1.6] font-medium text-foreground/75 max-w-[600px]"
          >
            A complete collection of Web3 dashboards, decentralized
            applications, and UI kits with a retro-futuristic aesthetic. Select
            a category or explore the gallery below.
          </p>
        </div>
      </div>
    </section>

    <div class="w-full flex flex-col gap-10">
      <ProjectsFilter client:load />

      <section class="max-w-[1240px] mx-auto w-full flex flex-col gap-6">
        <div
          class="w-full flex items-center justify-between pb-4 border-b border-white/10"
        >
          <div class="flex items-center gap-4">
            <h2 class="text-[24px] font-bold text-foreground">Projects</h2>
            <ProjectsViewToggle client:load />
          </div>
        </div>

        <ProjectsDisplay projects={projects} client:load />
      </section>
    </div>
  </div>
</Layout>
