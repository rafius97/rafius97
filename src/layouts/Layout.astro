---
import { ClientRouter } from 'astro:transitions';
import '@styles/global.css';
import Link from '@components/Link.astro';
import Navbar from '@components/Navbar.astro';
import { Terminal } from '@lucide/astro';

interface Props {
  title: string;
}

const { title = 'Rafael Romero - Portfolio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <main class="flex flex-col py-6">
      <div class="flex items-center justify-between px-6 md:px-[72px] py-4 relative z-50">
        <Link
          href="/"
          rel="noopener noreferrer"
          variant="plain"
          class="flex w-fit items-center gap-3"
        >
          <Terminal size={20} class="w-fit" />
          <span class="font-semibold text-[18px]">Rafael Romero</span>
        </Link>
        <Navbar />
      </div>
      <slot />
    </main>
  </body>
</html>
